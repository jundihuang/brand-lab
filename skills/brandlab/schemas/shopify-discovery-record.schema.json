{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["shopify_resource_id", "resource_type", "source_locale", "target_locale", "source", "digest"],
  "properties": {
    "shopify_resource_id": {"type": "string", "pattern": "^gid://shopify/.+"},
    "parent_shopify_resource_id": {"type": "string"},
    "resource_type": {"type": "string", "minLength": 1},
    "external_id": {"type": "string"},
    "source_locale": {"type": "string", "minLength": 1},
    "target_locale": {"type": "string", "minLength": 1},
    "market": {"type": "string"},
    "source": {"type": "string"},
    "digest": {"type": "string", "minLength": 1}
  }
}
