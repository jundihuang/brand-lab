{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "item_id",
    "status",
    "checks"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "needs_review",
        "blocked"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "audited_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
