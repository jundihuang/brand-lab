{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["execution_id", "batch_id", "status", "created_at", "raw_output_path", "items"],
  "properties": {
    "execution_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "status": {"enum": ["executed", "failed"]},
    "created_at": {"type": "string"},
    "store": {"type": "string"},
    "raw_output_path": {"type": "string"},
    "command_record_path": {"type": "string"},
    "user_errors": {"type": "array", "items": {"type": "object"}},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "shopify_resource_id", "field", "after", "status"],
        "properties": {
          "item_id": {"type": "string"},
          "shopify_resource_id": {"type": "string"},
          "field": {"type": "string"},
          "after": {"type": "string"},
          "status": {"enum": ["success", "failed", "verified", "mismatched"]},
          "readback": {"type": ["string", "null"]},
          "user_errors": {"type": "array"}
        }
      }
    }
  }
}
