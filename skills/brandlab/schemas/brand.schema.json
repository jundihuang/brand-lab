{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "brand",
    "mode",
    "source_language",
    "working_language",
    "markets"
  ],
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "pure",
        "shopify_controlled"
      ]
    },
    "source_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "working_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "default_tone": {
      "type": "string"
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "market",
          "locale",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "shopify_locale": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "source_strategy": {
            "enum": [
              "base",
              "bridge",
              "existing_translation"
            ]
          },
          "translation_mode": {
            "enum": [
              "localization_only",
              "manual_only",
              "translation"
            ]
          },
          "review_required": {
            "type": "boolean"
          },
          "audit_policy": {
            "enum": [
              "custom",
              "seo_and_legal",
              "standard"
            ]
          },
          "audit_mode": {
            "enum": [
              "auto",
              "paired_source",
              "target_only"
            ]
          }
        }
      }
    },
    "shopify": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "required": [
        "default_locale"
      ],
      "properties": {
        "default_locale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
